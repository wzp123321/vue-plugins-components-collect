<template>
  <view
    class="icon"
    <!-- #ifdef H5 -->
    :class="$attrs.class"
    :style="[iconStyle, $attrs.style]"
    <!-- #endif -->
    <!-- #ifndef H5 -->
    :style="[iconStyle]"
    <!-- #endif -->
    :hover-class="hoverClass"
    @tap="onTap"
  >
    <!-- #ifdef H5 -->
    <svg class="icon-svg" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><path fill="currentColor" d="M11 3a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0zM11 20a1 1 0 1 1 2 0v1a1 1 0 1 1-2 0zM2 12a1 1 0 0 0 1 1h1a1 1 0 1 0 0-2H3a1 1 0 0 0-1 1M20 13a1 1 0 1 1 0-2h1a1 1 0 1 1 0 2zM6.343 4.929A1 1 0 0 0 4.93 6.343l.707.707A1 1 0 0 0 7.05 5.636zM16.95 18.364a1 1 0 0 1 1.414-1.414l.707.707a1 1 0 0 1-1.414 1.414zM4.929 17.657a1 1 0 1 0 1.414 1.414l.707-.707a1 1 0 1 0-1.414-1.414zM18.364 7.05a1 1 0 1 1-1.414-1.414l.707-.707a1 1 0 1 1 1.414 1.414zM12 6a6 6 0 1 0 0 12 6 6 0 0 0 0-12"/></svg>
    <!-- #endif -->
    <!-- #ifndef H5 -->
    <image :src="imgSrc" class="icon-image" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
<!-- #ifndef H5 -->
import imgSrc from '@/uni_modules/@zpackage/mobile-package/ts-icon/mobile/uvue/icon-sunny-fill/sunny_fill.png'
<!-- #endif -->

const props = defineProps({
  size: { type: [String, Number], default: 22 },
  color: { type: String, default: '' },
  hoverClass: { type: String, default: '' }
})

const iconSize = computed(() => {
  const size = props.size
  if (typeof size === 'number') return size + 'px'
  return size.endsWith('px') ? size : size + 'px'
})

const iconColor = computed(() => props.color ?? 'currentColor')

const iconStyle = computed(() => ({
  '--icon-size': iconSize.value,
  '--icon-color': iconColor.value
}))

const emit = defineEmits(['click'])
function onTap() {
  emit('click')
}
</script>

<style scoped lang="scss">
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  /* #ifdef H5 */
  color: var(--icon-color, currentColor);
  /* #endif */
}
/* #ifdef H5 */
.icon :deep(svg) {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  color: inherit;
}
/* #endif */
.icon-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
</style>