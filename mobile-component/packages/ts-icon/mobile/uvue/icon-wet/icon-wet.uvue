<template>
  <view
    class="icon"
    <!-- #ifdef H5 -->
    :class="$attrs.class"
    :style="[iconStyle, $attrs.style]"
    <!-- #endif -->
    <!-- #ifndef H5 -->
    :style="[iconStyle]"
    <!-- #endif -->
    :hover-class="hoverClass"
    @tap="onTap"
  >
    <!-- #ifdef H5 -->
    <svg class="icon-svg" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><path fill="currentColor" fill-rule="evenodd" d="M16.696 2.378a1.183 1.183 0 0 1 1.608 0c.28.258.93.892 1.517 1.724C20.39 4.91 21 6.042 21 7.278 21 9.252 19.512 11 17.5 11S14 9.252 14 7.278c0-1.235.61-2.368 1.18-3.176.446-.625.954-1.202 1.516-1.724m.804 2.028a9 9 0 0 0-.686.848c-.49.695-.814 1.41-.814 2.024C16 8.31 16.75 9 17.5 9S19 8.31 19 7.278c0-.614-.324-1.329-.814-2.024q-.316-.446-.686-.848m-12.792.957a1.18 1.18 0 0 1 1.584 0c.206.186.608.573.966 1.073C7.6 6.913 8 7.627 8 8.444 8 9.82 6.915 11 5.5 11S3 9.82 3 8.444c0-.817.4-1.531.742-2.008.358-.5.76-.887.966-1.073M5.5 7.427q-.069.085-.132.174C5.11 7.96 5 8.254 5 8.444c0 .342.258.556.5.556s.5-.214.5-.556c0-.19-.11-.483-.368-.843a4 4 0 0 0-.132-.174m4.71 1.934a1.184 1.184 0 0 1 1.58 0 17.4 17.4 0 0 1 2.331 2.56c.923 1.254 1.879 2.973 1.879 4.8C16 19.572 13.824 22 11 22s-5-2.427-5-5.278c0-1.828.956-3.547 1.879-4.801a17.4 17.4 0 0 1 2.332-2.56zm.79 2.005c-.42.416-.982 1.022-1.51 1.74C8.643 14.256 8 15.544 8 16.722 8 18.597 9.405 20 11 20s3-1.403 3-3.278c0-1.178-.643-2.465-1.49-3.616a15 15 0 0 0-1.51-1.74" clip-rule="evenodd"/></svg>
    <!-- #endif -->
    <!-- #ifndef H5 -->
    <image :src="imgSrc" class="icon-image" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
<!-- #ifndef H5 -->
import imgSrc from '@/uni_modules/@zpackage/mobile-package/ts-icon/mobile/uvue/icon-wet/wet.png'
<!-- #endif -->

const props = defineProps({
  size: { type: [String, Number], default: 22 },
  color: { type: String, default: '' },
  hoverClass: { type: String, default: '' }
})

const iconSize = computed(() => {
  const size = props.size
  if (typeof size === 'number') return size + 'px'
  return size.endsWith('px') ? size : size + 'px'
})

const iconColor = computed(() => props.color ?? 'currentColor')

const iconStyle = computed(() => ({
  '--icon-size': iconSize.value,
  '--icon-color': iconColor.value
}))

const emit = defineEmits(['click'])
function onTap() {
  emit('click')
}
</script>

<style scoped lang="scss">
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  /* #ifdef H5 */
  color: var(--icon-color, currentColor);
  /* #endif */
}
/* #ifdef H5 */
.icon :deep(svg) {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  color: inherit;
}
/* #endif */
.icon-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
</style>