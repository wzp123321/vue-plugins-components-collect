<template>
  <view
    class="icon"
    <!-- #ifdef H5 -->
    :class="$attrs.class"
    :style="[iconStyle, $attrs.style]"
    <!-- #endif -->
    <!-- #ifndef H5 -->
    :style="[iconStyle]"
    <!-- #endif -->
    :hover-class="hoverClass"
    @tap="onTap"
  >
    <!-- #ifdef H5 -->
    <svg class="icon-svg" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><path fill="currentColor" fill-rule="evenodd" d="M4 4a2 2 0 0 0-2 2v2h2v-.586l6.94 6.94a1.5 1.5 0 0 0 2.12 0L20 7.414V18H4v-1H2v1a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm14.586 2H5.414L12 12.586z" clip-rule="evenodd"/><path fill="currentColor" d="M2 10a1 1 0 0 0 0 2h3a1 1 0 1 0 0-2zM0 14a1 1 0 0 1 1-1h5a1 1 0 1 1 0 2H1a1 1 0 0 1-1-1"/></svg>
    <!-- #endif -->
    <!-- #ifndef H5 -->
    <image :src="imgSrc" class="icon-image" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
<!-- #ifndef H5 -->
import imgSrc from '@/uni_modules/@zpackage/mobile-package/ts-icon/mobile/uvue/icon-mail-send/mail_send.png'
<!-- #endif -->

const props = defineProps({
  size: { type: [String, Number], default: 22 },
  color: { type: String, default: '' },
  hoverClass: { type: String, default: '' }
})

const iconSize = computed(() => {
  const size = props.size
  if (typeof size === 'number') return size + 'px'
  return size.endsWith('px') ? size : size + 'px'
})

const iconColor = computed(() => props.color ?? 'currentColor')

const iconStyle = computed(() => ({
  '--icon-size': iconSize.value,
  '--icon-color': iconColor.value
}))

const emit = defineEmits(['click'])
function onTap() {
  emit('click')
}
</script>

<style scoped lang="scss">
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  /* #ifdef H5 */
  color: var(--icon-color, currentColor);
  /* #endif */
}
/* #ifdef H5 */
.icon :deep(svg) {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  color: inherit;
}
/* #endif */
.icon-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
</style>