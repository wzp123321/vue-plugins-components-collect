<template>
  <view
    class="icon"
    <!-- #ifdef H5 -->
    :class="$attrs.class"
    :style="[iconStyle, $attrs.style]"
    <!-- #endif -->
    <!-- #ifndef H5 -->
    :style="[iconStyle]"
    <!-- #endif -->
    :hover-class="hoverClass"
    @tap="onTap"
  >
    <!-- #ifdef H5 -->
    <svg class="icon-svg" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><path fill="currentColor" d="M17 10.5a1 1 0 0 1 1 1v.626q.505.132.951.382l.434-.455a1 1 0 0 1 1.449 1.378l-.436.459c.212.34.375.715.477 1.115h.63a1 1 0 0 1 0 2h-.632a4 4 0 0 1-.424 1.018l.448.449a1 1 0 1 1-1.414 1.414l-.445-.446a4 4 0 0 1-1.038.434v.626a1 1 0 1 1-2 0v-.626a4 4 0 0 1-.937-.374l-.43.454a1 1 0 0 1-1.45-1.378l.428-.451a4 4 0 0 1-.484-1.12h-.622a1 1 0 0 1 0-2h.62c.095-.372.243-.722.434-1.044l-.44-.44a1 1 0 0 1 1.414-1.414l.443.443c.316-.186.66-.33 1.024-.424V11.5a1 1 0 0 1 1-1M9 18a1 1 0 1 1 0 2H4a1 1 0 1 1 0-2zm8-4a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-6-3a1 1 0 1 1 0 2H4a1 1 0 1 1 0-2zm9-7a1 1 0 1 1 0 2H4a1 1 0 0 1 0-2z"/></svg>
    <!-- #endif -->
    <!-- #ifndef H5 -->
    <image :src="imgSrc" class="icon-image" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
<!-- #ifndef H5 -->
import imgSrc from '@/uni_modules/@zpackage/mobile-package/ts-icon/mobile/uvue/icon-list-setting/list_setting.png'
<!-- #endif -->

const props = defineProps({
  size: { type: [String, Number], default: 22 },
  color: { type: String, default: '' },
  hoverClass: { type: String, default: '' }
})

const iconSize = computed(() => {
  const size = props.size
  if (typeof size === 'number') return size + 'px'
  return size.endsWith('px') ? size : size + 'px'
})

const iconColor = computed(() => props.color ?? 'currentColor')

const iconStyle = computed(() => ({
  '--icon-size': iconSize.value,
  '--icon-color': iconColor.value
}))

const emit = defineEmits(['click'])
function onTap() {
  emit('click')
}
</script>

<style scoped lang="scss">
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  /* #ifdef H5 */
  color: var(--icon-color, currentColor);
  /* #endif */
}
/* #ifdef H5 */
.icon :deep(svg) {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  color: inherit;
}
/* #endif */
.icon-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
</style>