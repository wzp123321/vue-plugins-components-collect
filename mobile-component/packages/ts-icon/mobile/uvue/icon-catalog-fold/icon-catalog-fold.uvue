<template>
  <view
    class="icon"
    <!-- #ifdef H5 -->
    :class="$attrs.class"
    :style="[iconStyle, $attrs.style]"
    <!-- #endif -->
    <!-- #ifndef H5 -->
    :style="[iconStyle]"
    <!-- #endif -->
    :hover-class="hoverClass"
    @tap="onTap"
  >
    <!-- #ifdef H5 -->
    <svg class="icon-svg" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet"><path fill="currentColor" d="M4 6a1 1 0 0 1 0-2h8a1 1 0 1 1 0 2zm16.837 2.394c.132.258-.062.556-.38.583l-.565.043-.464.025-.527.02-.585.011h-.61l-.555-.01-.504-.018-.448-.023L15.811 9l-.324-.026c-.296-.027-.461-.299-.332-.552l.15-.29.19-.345.228-.399q.06-.105.129-.217l.288-.467.16-.248q.164-.255.32-.482l.3-.429.274-.375.242-.318.206-.26c.183-.227.53-.236.704-.021l.326.415.263.35.292.408q.23.327.48.71l.301.476.264.437q.121.209.225.394l.188.344zm0 10c.132.257-.062.556-.38.583l-.565.042-.464.026-.527.02-.585.011h-.61l-.555-.01-.504-.018-.448-.023-.558-.04-.154-.013c-.296-.026-.461-.298-.332-.552l.15-.289.19-.346.228-.398q.06-.105.129-.217l.288-.467.322-.496.31-.455q.075-.108.148-.208l.274-.375.242-.318.206-.261c.183-.226.53-.235.704-.02l.326.415.263.35.292.408q.23.326.48.71l.156.243.282.457.244.416.108.19.188.345zM4 20a1 1 0 0 1 0-2h8a1 1 0 0 1 0 2zm-1-8a1 1 0 0 0 1 1h8a1 1 0 0 0 0-2H4a1 1 0 0 0-1 1"/></svg>
    <!-- #endif -->
    <!-- #ifndef H5 -->
    <image :src="imgSrc" class="icon-image" />
    <!-- #endif -->
  </view>
</template>

<script setup lang="uts">
import { computed } from 'vue'
<!-- #ifndef H5 -->
import imgSrc from '@/uni_modules/@zpackage/mobile-package/ts-icon/mobile/uvue/icon-catalog-fold/catalog_fold.png'
<!-- #endif -->

const props = defineProps({
  size: { type: [String, Number], default: 22 },
  color: { type: String, default: '' },
  hoverClass: { type: String, default: '' }
})

const iconSize = computed(() => {
  const size = props.size
  if (typeof size === 'number') return size + 'px'
  return size.endsWith('px') ? size : size + 'px'
})

const iconColor = computed(() => props.color ?? 'currentColor')

const iconStyle = computed(() => ({
  '--icon-size': iconSize.value,
  '--icon-color': iconColor.value
}))

const emit = defineEmits(['click'])
function onTap() {
  emit('click')
}
</script>

<style scoped lang="scss">
.icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: var(--icon-size, 22px);
  height: var(--icon-size, 22px);
  /* #ifdef H5 */
  color: var(--icon-color, currentColor);
  /* #endif */
}
/* #ifdef H5 */
.icon :deep(svg) {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
  color: inherit;
}
/* #endif */
.icon-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
</style>