{
  "name": "mobile-token",
  "version": "0.0.21",
  "description": "Design tokens for ts-mobile-ui components",
  "main": "dist/index.ts",
  "module": "dist/index.ts",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.ts"
    },
    "./theme-provider/uniapp/*": "./dist/theme-provider/uniapp/*",
    "./theme-provider/uniapp-x/*": "./dist/theme-provider/uniapp-x/*",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "bin": {
    "@zpackage/mobile-package/token": "scripts/install.js"
    },
    "keywords": [
    "tokens",
    "design-tokens",
    "phillUI"
  ],
  "author": "",
  "license": "MIT",
  "sideEffects": false
}
