# 确保 preinstall 脚本在所有包管理器中都能执行
ignore-scripts=false

# ── 依赖源 ──
# 公司私有 Nexus 源（用户级 ~/.npmrc 里 registry 默认指向它）只给 @tiansu 作用域用。
@tiansu:registry=http://192.168.20.200:7049/repository/npm-public/

# 其余公共包一律走官方源。
# 原因：私有源对 three 这类公共包直接返回 403 Forbidden（no authorization header），
# 不覆盖的话 pnpm add / pnpm install 拉公共依赖都会失败。
registry=https://registry.npmjs.org/
